# 旧版产物：只留清单与 14_m2_rebuild 钉住的 preds.csv，排除大体积重复副本
data/m2/legacy-20261122/output/**/*.pkl
data/m2/legacy-20261122/output/preds_*.csv
data/m2/legacy-20261122/output/ext_ab_*/preds.csv
# v1 采集的批量原始行情已被 verified-acquisition-v2 取代（保留回执与哈希）
data/m2/acquisition-20261122/raw/
data/m2/acquisition-20261122/sdk-raw/
data/m2/acquisition-20261122/legacy-dates.csv.gz

